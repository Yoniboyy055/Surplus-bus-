NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
OWNER_EMAIL=
CRON_SECRET=

# Sandbox mode — when true, parsers run but canonical writes are skipped
SANDBOX_MODE=false

# Email (Resend) – required for beta signups + campaign emails
RESEND_API_KEY=
EMAIL_FROM=Surplus Bus <onboarding@resend.dev>
EMAIL_TO=yourinbox@gmail.com
EMAIL_REPLY_TO=
# Mailto fallback in List-Unsubscribe (RFC 2369); one-click URL is always sent
EMAIL_UNSUBSCRIBE_MAILTO=
# Public site URL used in emails, OG tags and the sitemap (falls back to NEXT_PUBLIC_APP_URL)
NEXT_PUBLIC_SITE_URL=

# Legal / CASL sender identification (shown on legal pages and in every email footer)
LEGAL_OPERATOR_NAME=
BUSINESS_MAILING_ADDRESS=
PRIVACY_CONTACT_EMAIL=

# Stripe (TEST MODE keys until Yonatan approves live). Checkout stays disabled until price IDs are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
# Set to 1 only after Stripe Tax is configured
STRIPE_AUTOMATIC_TAX=
# Test override only (mock Stripe in tests)
STRIPE_API_BASE=

# Shared rate-limit store (optional; in-memory per-instance fallback when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics: both OFF by default
# Server-side no-PII events into public.analytics_events (migration 055)
ANALYTICS_EVENTS_ENABLED=
# Vercel Web Analytics script (1 = on)
NEXT_PUBLIC_VERCEL_WEB_ANALYTICS=

# Open-data ingest tuning (optional)
OPENDATA_GCSURPLUS_FILES=
OPENDATA_GCSURPLUS_MAX_ROWS=
# Test override only (mock Resend in tests)
RESEND_API_URL=
