{
  "name": "surplus-bus",
  "version": "1.0.0",
  "description": "Surplus Bus — Canadian public surplus listings information service (not a broker).",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "audit:scope": "node scripts/audit-scope.js",
    "audit:routes": "node scripts/audit-routes.js",
    "validate:source-records": "npx tsx scripts/validate-source-records-upsert.ts",
    "test:opendata": "npx tsx scripts/test-opendata-parsers.ts",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test:security": "npx tsx scripts/test-rate-limit.ts && npx tsx scripts/test-input-hardening.ts",
    "check:crons": "node scripts/check-crons.mjs",
    "test:analytics": "npx tsx scripts/test-analytics.ts",
    "test": "npm run test:opendata && npm run test:security && npm run test:analytics && npm run check:crons"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yoniboyy055/Surplus-bus-.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Yoniboyy055/Surplus-bus-/issues"
  },
  "homepage": "https://github.com/Yoniboyy055/Surplus-bus-#readme",
  "private": true,
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "@vercel/analytics": "^1.6.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.562.0",
    "nanoid": "^5.1.6",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.12.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.19",
    "dotenv": "^17.3.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.5"
  }
}
